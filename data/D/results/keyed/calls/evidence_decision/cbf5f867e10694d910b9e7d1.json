}, {\"id\": \"A32b7c59ed5fb1c\", \"component_name\": \"Redis PubSub\", \"target_sentence_id\": 47, \"target_sentence\": \"It subscribes to messages from the Redis PubSub as well as publishes events to Redis.\"}, {\"id\": \"A331409e4171f2f\", \"component_name\": \"Apps\", \"target_sentence_id\": 45, \"target_sentence\": \"BigBlueButton Apps has several components for it to communicate externally.\"}, {\"id\": \"A3ae41cde82bb96\", \"component_name\": \"HTML5 Client\", \"target_sentence_id\": 8, \"target_sentence\": \"The Client also uploads presentations to Web API.\"}]}"
